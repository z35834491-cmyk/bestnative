# ============================================================
# BestNative Backend — .env.example
# 复制为 .env 并填入真实值。生产环境务必通过环境变量注入密钥。
# ============================================================

# ---- App ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql+asyncpg://bestnative:bestnative@localhost:5432/bestnative
DATABASE_URL_SYNC=postgresql://bestnative:bestnative@localhost:5432/bestnative

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Observability ----
PROMETHEUS_URL=http://localhost:9090
# Elasticsearch（日志检索，复用现有 ES）
ES_HOST=192.168.12.111
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=

# ---- LLM (DeepSeek) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- Auth (生产必须替换为随机 32+ 字符) ----
SECRET_KEY=dev-only-insecure-key-change-in-production-min-32c

# ---- Infra Discovery ----
K8S_IN_CLUSTER=false
KUBECONFIG=
DISCOVERY_INTERVAL=300

# ---- Security Scan ----
SCAN_TOOLS_PATH=/usr/local/bin
AUTO_SCAN_CRON=0 3 * * *
